<%- include('../partials/admin-head') %>

<div class="panel">
  <div class="panel__head"><h2>إضافة خدمة</h2></div>
  <form method="post" action="/admin/services" class="form-grid">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="panel__body">
      <div class="form-grid form-grid--2">
        <div class="field">
          <label for="title">اسم الخدمة</label>
          <input class="input" id="title" name="title" type="text" required minlength="2" maxlength="160">
        </div>
        <div class="field">
          <label for="sort_order">ترتيب العرض</label>
          <input class="input" id="sort_order" name="sort_order" type="number" value="0" step="1">
        </div>
      </div>
      <div class="field">
        <label for="description">وصف الخدمة</label>
        <textarea class="textarea" id="description" name="description" maxlength="1200"></textarea>
      </div>
      <div class="field">
        <label class="check">
          <input type="checkbox" name="is_published" value="1" checked>
          تظهر هذه الخدمة على الموقع
        </label>
      </div>
    </div>
    <div class="panel__foot">
      <button class="btn" type="submit">إضافة الخدمة</button>
      <a class="btn btn--white" href="/services" target="_blank" rel="noopener">معاينة صفحة الخدمات ↗</a>
    </div>
  </form>
</div>

<% if (services.length) { %>
  <% services.forEach(s => { %>
    <div class="panel">
      <div class="panel__head">
        <h2><%= s.title %></h2>
        <span class="chip chip--<%= s.is_published ? 'published' : 'draft' %>"><%= s.is_published ? 'منشورة' : 'مخفية' %></span>
      </div>
      <form method="post" action="/admin/services/<%= s.id %>" class="form-grid">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="panel__body">
          <div class="form-grid form-grid--2">
            <div class="field">
              <label for="title-<%= s.id %>">اسم الخدمة</label>
              <input class="input" id="title-<%= s.id %>" name="title" type="text" value="<%= s.title %>" maxlength="160">
            </div>
            <div class="field">
              <label for="sort-<%= s.id %>">الترتيب</label>
              <input class="input" id="sort-<%= s.id %>" name="sort_order" type="number" value="<%= s.sort_order %>" step="1">
            </div>
          </div>
          <div class="field">
            <label for="desc-<%= s.id %>">الوصف</label>
            <textarea class="textarea" id="desc-<%= s.id %>" name="description" maxlength="1200"><%= s.description || '' %></textarea>
          </div>
          <div class="field">
            <label class="check">
              <input type="checkbox" name="is_published" value="1" <%- s.is_published ? 'checked' : '' %>>
              تظهر هذه الخدمة على الموقع
            </label>
          </div>
        </div>
        <div class="panel__foot">
          <button class="btn btn--sm" type="submit">حفظ</button>
        </div>
      </form>
      <div class="panel__body" style="padding-top:0">
        <form method="post" action="/admin/services/<%= s.id %>/delete" data-confirm="سيتم حذف الخدمة نهائيًا. متابعة؟">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn--danger btn--sm" type="submit">حذف الخدمة</button>
        </form>
      </div>
    </div>
  <% }); %>
<% } else { %>
  <div class="empty-state">
    <h3>لا توجد خدمات</h3>
    <p>أضف الخدمات التي تقدّمها الشركة فعليًا فقط، ولا تنشر خدمات غير متاحة.</p>
  </div>
<% } %>

<%- include('../partials/admin-foot') %>
